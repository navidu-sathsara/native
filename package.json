{
  "name": "native-launcher",
  "productName": "Native",
  "desktopName": "Native.desktop",
  "version": "3.9.0",
  "description": "Native — a fast, beautiful Minecraft launcher",
  "main": "./out/main/index.js",
  "author": {
    "name": "Native Labs",
    "email": "support@nativelauncher.app"
  },
  "homepage": "https://github.com/navidu-sathsara/native",
  "repository": {
    "type": "git",
    "url": "https://github.com/navidu-sathsara/native.git"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "e2e": "playwright test --project e2e",
    "qa:visual": "playwright test --project visual-qa && node scripts/qa-report.mjs",
    "package:linux": "node scripts/gen-icon.mjs && electron-vite build && electron-builder --linux",
    "package:win": "node scripts/gen-icon.mjs && electron-vite build && electron-builder --win",
    "package:mac": "node scripts/gen-icon.mjs && electron-vite build && electron-builder --mac",
    "package:dir": "node scripts/gen-icon.mjs && electron-vite build && electron-builder --dir",
    "postinstall": "node scripts/patch-nsis.mjs || true",
    "package:win-host": "node scripts/gen-icon.mjs && electron-vite build && NSIS_UNINSTALLER_READER=true electron-builder --win nsis --x64 -c.win.signAndEditExecutable=false -c.nsis.warningsAsErrors=false",
    "brand:win": "node scripts/brand-win-exe.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xhayper/discord-rpc": "^1.3.4",
    "better-sqlite3": "^12.6.2",
    "dompurify": "^3.4.12",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "marked": "^18.0.7",
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.1.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "framer-motion": "^12.43.0",
    "happy-dom": "^20.11.1",
    "js-yaml": "^5.2.2",
    "lucide-react": "^1.28.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resedit": "^3.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "zustand": "^5.0.2"
  }
}
